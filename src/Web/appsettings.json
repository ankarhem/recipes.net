{
  "ServiceName": "recipes",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Otel": {
    "OtlpEndpoint": "http://localhost:4317",
    "ConsoleExporterEnabled": true
  },
  "Temporal": {
    "Target": "localhost:7233",
    "Namespace": "default",
    "TaskQueue": "recipes"
  },
  "Jwt": {
    "Issuer": "recipes",
    "Audience": "recipes",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  }
}
